<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Allow plain http:// to the locally running backend during development.
         Android 9 (API 28) blocks cleartext traffic by default, which would
         otherwise make every request to AppConfig.baseUrl fail. Debug-only so
         release builds keep the secure default. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
